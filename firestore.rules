rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isMember(householdId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    match /households/{householdId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isMember(householdId);

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == memberId;
        allow update: if isSignedIn() && request.auth.uid == memberId;
        // Any current household member can remove a member profile —
        // e.g. a duplicate from signing in again on another device.
        allow delete: if isMember(householdId);

        match /tokens/{tokenId} {
          allow read, write: if isSignedIn() && request.auth.uid == memberId;
        }
      }

      match /items/{itemId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) && request.resource.data.createdBy == request.auth.uid;
        // update covers both normal field edits (data.js updateItem) and
        // deleting a whole cleared round (data.js deleteBatch) sweeping
        // batchId onto every item in it.
        allow update: if isMember(householdId);
        // delete covers both removing a single item (data.js deleteItem,
        // from the edit-item screen) and deleteBatch wiping every item
        // that was swept into a cleared round being removed.
        allow delete: if isMember(householdId);
      }

      match /batches/{batchId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId);
        allow delete: if isMember(householdId);
      }
    }
  }
}
